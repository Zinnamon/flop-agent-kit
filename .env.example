# Copy this file to .env and fill it in. .env is git-ignored; never commit it.
# Every program in this kit reads the same settings. One line switches network.

# Which FLOP network to use: devnet (works today) or testnet (when a testnet miner serves).
FLOP_NETWORK=devnet

# Your agent identity: an encrypted keystore written by `flop agent keys generate`,
# and a one-line file holding its password (mode 600). The kit never reads the
# keystore itself; Flop's CLI does, through --keystore and --password-env.
FLOP_KEYSTORE=/Users/you/.config/flop-agent/flop-agent.json
FLOP_PASSWORD_FILE=/Users/you/.config/flop-agent/password
# The keystore's public address (starts with 5). Public; safe to share.
FLOP_ADDRESS=5...

# Which model to buy answers from. See `flop-agent status` for what is served.
# On devnet the wallet-lane gateway key is scoped to the first registry model (read 26 November 2026).
FLOP_MODEL=qwen/qwen2.5-0.5b-instruct

# How inference is bought.
#   gateway  : the OpenAI-compatible FLOP gateway, with a wallet-signed key
#              from `flop agent credential`. Works for public agents today.
#   session  : a direct compute channel with one named miner (`flop session run`).
#              Needs a miner endpoint you can reach; set the three lines below.
FLOP_ROUTE=gateway
# FLOP_MINER=5...                      # the serving miner's SS58 account
# FLOP_ENDPOINT=https://miner.example  # that miner's opted-in session endpoint
# FLOP_MAX_FLOP=0.01                   # the escrow, which is the whole payment

# Optional: a gateway key you provisioned by hand, instead of asking the CLI.
# FLOP_GATEWAY_KEY=

# Where the kit keeps its own state (receipts, snapshots, its Technocore key).
# Outside the repository on purpose.
KIT_STATE_DIR=~/.local/state/flop-agent-kit

# Digest bot: posting to Technocore chat is OFF unless you set TECHNOCORE_POST=1.
TECHNOCORE_URL=https://technocore.chat
TECHNOCORE_ROOM=flop-testnet-digest
TECHNOCORE_POST=0

# Ask-the-docs page: local only by default.
DOCS_HOST=127.0.0.1
DOCS_PORT=8787
